---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'work' | 'about' | 'play' | 'notes';
  accent?: 'purple' | 'orange';
}
const { title, description = 'Business Analyst x Design Engineer — portfolio bridging business and engineering.', current, accent } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
const links = [
  { href: '/', label: 'Work', key: 'home' },
  { href: '/about', label: 'About', key: 'about' },
  { href: '/play', label: 'Play', key: 'play' },
  { href: '/notes', label: 'Notes', key: 'notes' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Mono&display=swap" rel="stylesheet" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%233f3f46'/><text x='50' y='68' font-size='52' text-anchor='middle' fill='white' font-family='sans-serif'>U</text></svg>" />
</head>
<body class={accent ? `cs-${accent}` : undefined}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-nav">
    <div class="in">
      <a class="brand" href="/"><b>Ujwal Ramesh Karajgikar</b><span>Business Analyst + Design Engineer</span></a>
      <button class="nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="siteLinks" aria-label="Open menu">
        <svg class="ico-open" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M2 5h16M2 10h16M2 15h16"/></svg>
        <svg class="ico-close" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16"/></svg>
      </button>
      <nav id="siteLinks" aria-label="Primary">
        {links.map((l) => (
          <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>
            {l.label}
            <svg class="chev" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
          </a>
        ))}
        <a href="/resume.pdf" aria-current={current === 'resume' ? 'page' : undefined}>
          Resume
          <svg class="ext" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M9 2h5v5M14 2L7 9M12 9v4H3V4h4"/></svg>
        </a>
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-foot">
    <div class="site-footer">
      <div class="ft-tag">
        Bridging business needs with product value
        <span class="ft-note">Horizon and Adapter are aliases. Client, vendor and product names are withheld by agreement.</span>
      </div>
      <div class="ft-links">
        <a href="https://www.linkedin.com/in/ujwal-karajgikar">LinkedIn</a>
        <a href="https://github.com/ujwalrk-fsit/ujwalrk">GitHub</a>
        <a href="mailto:ukarajgikar@gmail.com">Email</a>
      </div>
    </div>
  </footer>
  <script is:inline>
    const toggle=document.getElementById('navToggle'),links=document.getElementById('siteLinks');
    const set=(o)=>{links.classList.toggle('open',o);toggle.setAttribute('aria-expanded',o);toggle.setAttribute('aria-label',o?'Close menu':'Open menu')};
    toggle.onclick=()=>set(!links.classList.contains('open'));
    links.addEventListener('click',e=>{if(e.target.closest('a'))set(false)});
    addEventListener('keydown',e=>{if(e.key==='Escape'&&links.classList.contains('open')){set(false);toggle.focus()}});
    addEventListener('resize',()=>{if(innerWidth>900&&links.classList.contains('open'))set(false)});
  </script>
</body>
</html>
