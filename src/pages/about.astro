        <div class="hero-actions">
          <a href="/resume.pdf" class="btn btn-primary">View Resume</a>
          <a href="mailto:ukarajgikar@gmail.com" class="btn btn-secondary">Get in Touch</a>
        </div>
        <div class="hero-meta">
          <span class="meta-item"><span class="meta-label">Location</span> Bengaluru, India</span>
          <span class="meta-item"><span class="meta-label">Role</span> BA & Product Designer</span>
          <span class="meta-item"><span class="meta-label">Focus</span> AI/ML Products, FinTech, Healthcare</span>
          <span class="meta-item"><span class="meta-label">Open to</span> Senior BA / Product Designer roles</span>
        </div>
      </div>
    </header>

    <!-- Impact Stats -->
