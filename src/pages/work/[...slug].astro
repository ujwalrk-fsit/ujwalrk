---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---
<Base title={`${entry.data.title} · Folio`} description={entry.data.summary} current="work">
  <div class="cur" id="cur"></div>
  <div class="wrap">
    <aside class="cs-aside" id="outline" tabindex="-1" aria-label="Contents">
      <a href="#context">Context</a><a class="n" href="#problem" data-p="context">Problem</a><a class="n" href="#principles" data-p="context">Product principles</a>
      <a href="#built">What We Built</a><a class="n" href="#flows" data-p="built">Core flows</a><a class="n" href="#roles" data-p="built">Who sees what</a>
      <a href="#foundations">Platform Foundations</a><a class="n" href="#f1" data-p="foundations">Signing</a><a class="n" href="#f2" data-p="foundations">Security &amp; access</a><a class="n" href="#f3" data-p="foundations">Real-time &amp; reliability</a><a class="n" href="#f4" data-p="foundations">Audit &amp; compliance</a><a class="n" href="#f5" data-p="foundations">Release &amp; observability</a>
      <a href="#decisions">Key Decisions</a><a class="n" href="#d1" data-p="decisions">Investor tiers</a><a class="n" href="#d2" data-p="decisions">Payments</a><a class="n" href="#d3" data-p="decisions">E-signature</a><a class="n" href="#d4" data-p="decisions">Infrastructure &amp; cost</a><a class="n" href="#d5" data-p="decisions">Scope</a>
      <a href="#delivery">Delivery Story</a><a href="#quality">Quality &amp; Ways of Working</a><a href="#outcomes">Outcomes</a><a href="#learned">What I'd Do Differently</a><a href="#next">What's Next</a>
    </aside>
    <main>
      <Content />
    </main>
  </div>
  <button class="fab" id="fab" type="button" aria-expanded="false" aria-controls="outline">Contents</button>
  <div class="bd" id="bd"></div>
  <script is:inline>
    const aside=document.getElementById('outline'),cur=document.getElementById('cur'),fab=document.getElementById('fab'),bd=document.getElementById('bd'),
    links=[...aside.querySelectorAll('a[href^="#"]')].filter(a=>a.hash.length>1),els=links.map(a=>document.getElementById(a.hash.slice(1))),by=h=>links.find(a=>a.hash==='#'+h);
    const nm=new Map(links.map(a=>[a,a.textContent]));links.forEach(a=>{if(!a.dataset.p){const n=links.filter(x=>x.dataset.p===a.hash.slice(1)).length;if(n)a.insertAdjacentHTML('beforeend','<em>'+n+'</em>')}});
    let t=false,last='';
    function spy(){t=false;let i=0;els.forEach((e,k)=>{if(e&&e.getBoundingClientRect().top<=100)i=k});
    links.forEach(a=>a.classList.remove('on','par'));const l=links[i],pr=l.dataset.p?by(l.dataset.p):null;
    if(!l) return;
    l.classList.add('on');if(pr)pr.classList.add('par');
    const h=els[0].getBoundingClientRect().top>140?'<b>Horizon</b>':(pr?'<span>'+nm.get(pr)+' · </span>':'')+'<b>'+nm.get(l)+'</b>';
    if(h!==last){cur.innerHTML=h;last=h}}
    function sheet(o,f){aside.classList.toggle('open',o);bd.classList.toggle('on',o);document.body.classList.toggle('lock',o);fab.setAttribute('aria-expanded',o);fab.textContent=o?'✕ Close':'Contents';if(o){const c=aside.querySelector('a.on');if(c)aside.scrollTop=c.offsetTop-aside.clientHeight/2}if(f!==false)(o?aside:fab).focus({preventScroll:true})}
    fab.onclick=()=>sheet(!aside.classList.contains('open'));bd.onclick=()=>sheet(false);
    aside.addEventListener('click',e=>{if(e.target.closest('a')&&aside.classList.contains('open'))sheet(false,false)});
    addEventListener('keydown',e=>{if(e.key==='Escape'&&aside.classList.contains('open'))sheet(false)});
    addEventListener('resize',()=>{if(innerWidth>900&&aside.classList.contains('open'))sheet(false,false)});
    addEventListener('scroll',()=>{if(!t){t=true;requestAnimationFrame(spy)}},{passive:true});spy();
  </script>
</Base>
