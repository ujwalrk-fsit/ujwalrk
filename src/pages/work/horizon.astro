  <div class="bd" id="bd"></div>
  <script is:inline>
    const aside=document.getElementById('outline'),cur=document.getElementById('cur'),fab=document.getElementById('fab'),bd=document.getElementById('bd'),
    links=[...aside.querySelectorAll('a[href^="#"]')].filter(a=>a.hash.length>1),els=links.map(a=>document.getElementById(a.hash.slice(1))),by=h=>links.find(a=>a.hash==='#'+h);
    const nm=new Map(links.map(a=>[a,a.textContent]));links.forEach(a=>{if(!a.dataset.p){const n=links.filter(x=>x.dataset.p===a.hash.slice(1)).length;if(n)a.insertAdjacentHTML('beforeend','<em>'+n+'</em>')}});
    let t=false,last='';
    function spy(){t=false;let i=0;els.forEach((e,k)=>{if(e&&e.getBoundingClientRect().top<=100)i=k});
    links.forEach(a=>a.classList.remove('on','par'));const l=links[i],pr=l.dataset.p?by(l.dataset.p):null;
    if(!l) return;
    l.classList.add('on');if(pr)pr.classList.add('par');
    const h=els[0].getBoundingClientRect().top>140?'<b>Horizon</b>':(pr?'<span>'+nm.get(pr)+' · </span>':'')+'<b>'+nm.get(l)+'</b>';
    if(h!==last){cur.innerHTML=h;last=h}}
    function sheet(o,f){aside.classList.toggle('open',o);bd.classList.toggle('on',o);document.body.classList.toggle('lock',o);fab.setAttribute('aria-expanded',o);fab.textContent=o?'✕ Close':'Contents';if(o){const c=aside.querySelector('a.on');if(c)aside.scrollTop=c.offsetTop-aside.clientHeight/2}if(f!==false)(o?aside:fab).focus({preventScroll:true})}
    fab.onclick=()=>sheet(!aside.classList.contains('open'));bd.onclick=()=>sheet(false);
    aside.addEventListener('click',e=>{if(e.target.closest('a')&&aside.classList.contains('open'))sheet(false,false)});
    addEventListener('keydown',e=>{if(e.key==='Escape'&&aside.classList.contains('open'))sheet(false)});
    addEventListener('resize',()=>{if(innerWidth>900&&aside.classList.contains('open'))sheet(false,false)});
    addEventListener('scroll',()=>{if(!t){t=true;requestAnimationFrame(spy)}},{passive:true});spy();
  </script>
